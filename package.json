{
  "name": "yacwu",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:server": "export YACWU_BACKEND_ROOT=\"${YACWU_BACKEND_ROOT:-$PWD}\"; cd server && YACWU_STATIC=../build gleam run",
    "build": "vite build",
    "preview": "vite preview",
    "start": "export YACWU_BACKEND_ROOT=\"${YACWU_BACKEND_ROOT:-$PWD}\"; cd server && YACWU_STATIC=../build gleam run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "bun test tests/unit",
    "test:server": "cd server && gleam test",
    "test:adapter": "node --test 'tests/adapter/*.test.mjs'"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "svelte": "^5.20.0",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "marked": "^18.0.9",
    "monaco-editor": "^0.56.0"
  }
}
